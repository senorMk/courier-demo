enum OfficeType {
  SENDING
  RECEIVING
  DISPATCH
  TRANSIT
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  firstName        String?
  lastName         String?
  roleId           String
  role             Role              @relation(fields: [roleId], references: [id])
  logs             AccessLog[]
  scanningSessions ScanningSession[] @relation("UserScanningSessions")
  scans            ScannedParcel[]   @relation("UserParcelScans")
  officeId         String?
  office           Office?           @relation(fields: [officeId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model AccessLog {
  id        String   @id @default(uuid())
  email     String
  action    String
  success   Boolean
  timestamp DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  emailAddress    String?  @unique
  phoneNumber     String   @unique
  idNumber        String?  @unique
  sentParcels     Parcel[] @relation("Sender")
  receivedParcels Parcel[] @relation("Receiver")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TrackingCode {
  id              String   @id @default(uuid())
  routeCode       String
  destinationCode String
  branchCode      String
  parcelId        String   @unique
  parcel          Parcel   @relation(fields: [parcelId], references: [id])
  plainTextCode   String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Parcel {
  id           String          @id @default(uuid())
  parcelNumber Int             @unique @default(autoincrement())
  customerId   String
  receiverId   String
  officeId     String
  size         ParcelSize      @default(MEDIUM)
  items        ParcelItem[]
  customer     Customer        @relation("Sender", fields: [customerId], references: [id])
  receiver     Customer        @relation("Receiver", fields: [receiverId], references: [id])
  office       Office          @relation(fields: [officeId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  TrackingCode TrackingCode?
  scans        ScannedParcel[] @relation("ParcelScans")
  payment      Payment?
}

model ParcelItem {
  id           String   @id @default(uuid())
  quantity     Int
  description  String
  pricePerUnit Float
  value        Float
  amount       Float
  parcelId     String
  parcel       Parcel   @relation(fields: [parcelId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ParcelSize {
  SMALL
  MEDIUM
  LARGE
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
}

model Payment {
  id        String        @id @default(uuid())
  parcelId  String        @unique
  parcel    Parcel        @relation(fields: [parcelId], references: [id])
  amount    Float
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Route {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String            @unique
  offices          Office[]
  scanningSessions ScanningSession[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Office {
  id               String            @id @default(uuid())
  branchCode       String            @unique
  officeType       OfficeType
  name             String
  branchCodes      BranchCode[]
  parcels          Parcel[]
  users            User[]
  scanningSessions ScanningSession[]
  routeId          String
  route            Route             @relation(fields: [routeId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model BranchCode {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String   @unique
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScanningSession {
  id          String          @id @default(uuid())
  routeId     String
  officeId    String
  staffId     String // references User.id
  mode        String // 'bag' | 'individual'
  mailBagCode String?         @unique
  startedAt   DateTime        @default(now())
  closedAt    DateTime?
  scans       ScannedParcel[]
  user        User            @relation("UserScanningSessions", fields: [staffId], references: [id])
  office      Office          @relation(fields: [officeId], references: [id])
  route       Route           @relation(fields: [routeId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ScannedParcel {
  id                String          @id @default(uuid())
  scanningSessionId String
  parcelId          String
  scannedAt         DateTime        @default(now())
  scannedById       String // User.id
  scanningSession   ScanningSession @relation(fields: [scanningSessionId], references: [id])
  parcel            Parcel          @relation("ParcelScans", fields: [parcelId], references: [id])
  scannedBy         User            @relation("UserParcelScans", fields: [scannedById], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([scanningSessionId, parcelId])
}
