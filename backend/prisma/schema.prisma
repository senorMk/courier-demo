datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model Role {
  id   String  @id @default(uuid())
  name String  @unique
  users User[]
}

model User {
  id       String      @id @default(uuid())
  email    String      @unique
  password String
  roleId   String
  role     Role        @relation(fields: [roleId], references: [id])
  logs     AccessLog[]
}

model AccessLog {
  id        String   @id @default(uuid())
  email     String
  action    String
  success   Boolean
  timestamp DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
}
