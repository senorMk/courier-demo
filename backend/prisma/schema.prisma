generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessLog {
  id        String   @id
  action    String
  success   Boolean
  timestamp DateTime @default(now())
  userId    String?
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User?    @relation(fields: [userId], references: [id])
}

model Bay {
  id              String            @id
  name            String
  bayType         BayType
  officeId        String
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Office          Office            @relation(fields: [officeId], references: [id])
  ScanningSession ScanningSession[]

  @@unique([officeId, bayType])
}

model BranchCode {
  id        String   @id
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
  officeId  String
  Office    Office   @relation(fields: [officeId], references: [id])
}

model Complaint {
  id             String           @id
  parcelId       String
  reason         String?
  status         ComplaintStatus  @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  reporterId     String
  Parcel         Parcel           @relation(fields: [parcelId], references: [id])
  User           User             @relation(fields: [reporterId], references: [id])
  ComplaintEvent ComplaintEvent[]
}

model ComplaintEvent {
  id          String           @id
  complaintId String
  action      String
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus?
  note        String?
  createdAt   DateTime         @default(now())
  Complaint   Complaint        @relation(fields: [complaintId], references: [id])
}

model Customer {
  id                                 String   @id
  firstName                          String
  lastName                           String
  phoneNumber                        String   @unique
  idNumber                           String?  @unique
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime
  emailAddress                       String?  @unique
  Parcel_Parcel_customerIdToCustomer Parcel[] @relation("Parcel_customerIdToCustomer")
  Parcel_Parcel_receiverIdToCustomer Parcel[] @relation("Parcel_receiverIdToCustomer")
}

model Driver {
  id            String   @id
  firstName     String
  lastName      String
  phoneNumber   String?  @unique
  licenseNumber String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model Office {
  id                                    String            @id
  branchCode                            String            @unique
  name                                  String
  createdAt                             DateTime          @default(now())
  updatedAt                             DateTime
  routeId                               String
  officeTypes                           OfficeType[]
  areaCode                              String?
  Bay                                   Bay[]
  BranchCode                            BranchCode[]
  Route                                 Route             @relation(fields: [routeId], references: [id])
  Parcel_Parcel_officeIdToOffice        Parcel[]          @relation("Parcel_officeIdToOffice")
  Parcel_Parcel_sendingOfficeIdToOffice Parcel[]          @relation("Parcel_sendingOfficeIdToOffice")
  ScanningSession                       ScanningSession[]
  Trip_Trip_destinationOfficeIdToOffice Trip[]            @relation("Trip_destinationOfficeIdToOffice")
  Trip_Trip_officeIdToOffice            Trip[]            @relation("Trip_officeIdToOffice")
  User                                  User[]
}

model Parcel {
  id                                    String          @id
  customerId                            String
  receiverId                            String
  createdAt                             DateTime        @default(now())
  updatedAt                             DateTime
  parcelNumber                          Int             @unique @default(autoincrement())
  officeId                              String
  size                                  ParcelSize      @default(MEDIUM)
  status                                ParcelStatus    @default(PENDING)
  sendingOfficeId                       String?
  Complaint                             Complaint[]
  Customer_Parcel_customerIdToCustomer  Customer        @relation("Parcel_customerIdToCustomer", fields: [customerId], references: [id])
  Office_Parcel_officeIdToOffice        Office          @relation("Parcel_officeIdToOffice", fields: [officeId], references: [id])
  Customer_Parcel_receiverIdToCustomer  Customer        @relation("Parcel_receiverIdToCustomer", fields: [receiverId], references: [id])
  Office_Parcel_sendingOfficeIdToOffice Office?         @relation("Parcel_sendingOfficeIdToOffice", fields: [sendingOfficeId], references: [id])
  ParcelItem                            ParcelItem[]
  Payment                               Payment?
  ScannedParcel                         ScannedParcel[]
  TrackingCode                          TrackingCode?
}

model ParcelItem {
  id           String   @id
  quantity     Int
  description  String
  pricePerUnit Float
  value        Float
  amount       Float
  parcelId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Parcel       Parcel   @relation(fields: [parcelId], references: [id])
}

model Payment {
  id        String        @id
  parcelId  String        @unique
  amount    Float
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())
  updatedAt DateTime
  Parcel    Parcel        @relation(fields: [parcelId], references: [id])
}

model Role {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User[]
}

model Route {
  id              String            @id
  code            String            @unique
  name            String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Office          Office[]
  ScanningSession ScanningSession[]
  Trip            Trip[]
}

model ScannedParcel {
  id                String          @id
  scanningSessionId String
  parcelId          String
  scannedAt         DateTime        @default(now())
  scannedById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  Parcel            Parcel          @relation(fields: [parcelId], references: [id])
  User              User            @relation(fields: [scannedById], references: [id])
  ScanningSession   ScanningSession @relation(fields: [scanningSessionId], references: [id])

  @@unique([scanningSessionId, parcelId])
}

model ScanningSession {
  id            String          @id
  routeId       String
  officeId      String
  staffId       String
  mode          String
  mailBagCode   String?         @unique
  startedAt     DateTime        @default(now())
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  tripId        String?
  bayId         String?
  ScannedParcel ScannedParcel[]
  Bay           Bay?            @relation(fields: [bayId], references: [id])
  Office        Office          @relation(fields: [officeId], references: [id])
  Route         Route           @relation(fields: [routeId], references: [id])
  User          User            @relation(fields: [staffId], references: [id])
  Trip          Trip?           @relation(fields: [tripId], references: [id])
}

model TrackingCode {
  id              String   @id
  routeCode       String
  destinationCode String
  branchCode      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  parcelId        String   @unique
  plainTextCode   String   @unique
  Parcel          Parcel   @relation(fields: [parcelId], references: [id])
}

model Trip {
  id                                      String            @id
  routeId                                 String
  officeId                                String
  driverName                              String
  truckReg                                String
  status                                  TripStatus        @default(PLANNED)
  plannedAt                               DateTime          @default(now())
  departedAt                              DateTime?
  completedAt                             DateTime?
  createdAt                               DateTime          @default(now())
  updatedAt                               DateTime
  destinationOfficeId                     String?
  ScanningSession                         ScanningSession[]
  Office_Trip_destinationOfficeIdToOffice Office?           @relation("Trip_destinationOfficeIdToOffice", fields: [destinationOfficeId], references: [id])
  Office_Trip_officeIdToOffice            Office            @relation("Trip_officeIdToOffice", fields: [officeId], references: [id])
  Route                                   Route             @relation(fields: [routeId], references: [id])
  TripLog                                 TripLog[]
}

model TripLog {
  id          String      @id
  tripId      String
  action      String
  fromStatus  TripStatus?
  toStatus    TripStatus?
  performedBy String?
  note        String?
  timestamp   DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  Trip        Trip        @relation(fields: [tripId], references: [id])
}

model Truck {
  id           String   @id
  registration String   @unique
  make         String?
  model        String?
  capacity     Float?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model User {
  id                 String            @id
  password           String
  email              String            @unique
  roleId             String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  firstName          String?
  lastName           String?
  officeId           String?
  authorizedBayTypes BayType[]         @default([])
  AccessLog          AccessLog[]
  Complaint          Complaint[]
  ScannedParcel      ScannedParcel[]
  ScanningSession    ScanningSession[]
  Office             Office?           @relation(fields: [officeId], references: [id])
  Role               Role              @relation(fields: [roleId], references: [id])
}

enum BayType {
  SENDING
  RECEIVING
  DISPATCH
  SORTING
}

enum ComplaintStatus {
  OPEN
  CLOSED
}

enum OfficeType {
  SENDING
  RECEIVING
  DISPATCH
  TRANSIT
}

enum ParcelSize {
  SMALL
  MEDIUM
  LARGE
}

enum ParcelStatus {
  PENDING
  READY_FOR_COLLECTION
  COLLECTED
  DAMAGED
  COMPLAINT_BOX
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
}

enum TripStatus {
  PLANNED
  LOADING
  IN_TRANSIT
  COMPLETED
}
