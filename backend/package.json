{
  "name": "courier-management-system",
  "version": "1.0.0",
  "description": "Courier Management System backend",
  "main": "dist/main.js",
  "scripts": {
    "start": "nest start",
    "start:dev": "nodemon --watch src --exec ts-node -r tsconfig-paths/register src/main.ts",
    "build": "nest build",
    "deploy": "npm install && npm run migrate:smart && npm run seed:admin && npm run start:prod",
    "start:prod": "node dist/src/main.js",
    "prisma:dev": "npx prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:smart": "node scripts/smart-migrate.js",
    "seed:admin": "node dist/prisma/seed-admin.js",
    "seed:admin:dev": "ts-node -r tsconfig-paths/register prisma/seed-admin.ts",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^5.15.0",
    "africastalking": "^0.7.5",
    "archiver": "^7.0.1",
    "axios": "^1.11.0",
    "bcrypt": "^5.1.0",
    "bwip-js": "^4.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.0",
    "luxon": "^3.4.4",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.13.0",
    "svg-to-pdfkit": "^0.1.8",
    "prisma": "^5.15.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.19.11",
    "@types/passport-jwt": "^3.0.8",
    "jest": "^29.5.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  }
}
